// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/go
{
	"name": "Go",
	// Debian stable (trixie) based Go image
	"image": "mcr.microsoft.com/devcontainers/go:2-1.27-trixie",

	// Make sure the Claude Code config directory exists on the host,
	// otherwise Docker would create it owned by root.
	"initializeCommand": "mkdir -p \"${localEnv:HOME}/.claude\"",

	// Share the host Claude Code config (incl. credentials) with the container,
	// so the authentication survives container rebuilds.
	"mounts": [
		"source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind"
	],
	"containerEnv": {
		// Keeps .claude.json inside the mounted directory instead of $HOME
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
	},

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "./.devcontainer/postCreateCommand.sh",

	// Configure tool-specific properties.
	"customizations": {
		// Configure properties specific to VS Code.
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				"golang.go",
				"streetsidesoftware.code-spell-checker"
			]
		}
	}
}
